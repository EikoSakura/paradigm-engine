<div class="screen {{classes}}" data-look="{{state.look}}" data-bg="{{state.bg}}" data-layout="{{state.layout}}" data-shape="{{state.shape}}" style="--petal: {{petalColor}}">
  <div class="bg">
    <div class="bg-art">{{{bgHtml}}}</div>
    <div class="fx dim"></div>
    <div class="fx lines"></div>
    <div class="fx half"></div>
    <div class="fx grain"></div>
    <div class="fx vig"></div>
    <div class="fx petals">{{#each petals}}<span class="petal" style="{{this}}"></span>{{/each}}</div>
  </div>
  <div class="deco"><div class="sparkles">{{#each sparkles}}<i style="{{this}}"></i>{{/each}}</div></div>

  {{#if slate}}
  <header class="slate">
    {{#if slate.eyebrow}}<span class="eyebrow">{{slate.eyebrow}}</span>{{/if}}
    {{#if slate.title}}<h1 class="title">{{slate.title}}</h1>{{/if}}
    {{#if slate.where}}
    <div class="where">
      {{#if slate.scene}}<span><span class="k">{{localize "PARADIGMENGINE.Stage.Scene"}}</span>{{slate.scene}}</span>{{/if}}
      {{#if slate.time}}<span><span class="k">{{localize "PARADIGMENGINE.Stage.Time"}}</span>{{slate.time}}</span>{{/if}}
    </div>
    {{/if}}
    {{#if editing}}<button type="button" class="pen" data-action="editEpisode" aria-label="{{localize "PARADIGMENGINE.Stage.Edit"}}"><i class="fa-solid fa-pen" inert></i></button>{{/if}}
  </header>
  {{/if}}

  {{#if hasRecap}}
  <section class="recap">
    <span class="k">{{localize "PARADIGMENGINE.Title.PreviouslyOn"}}</span>
    {{#if editing}}
    <textarea name="recap" rows="3" aria-label="{{localize "PARADIGMENGINE.Title.PreviouslyOn"}}">{{recap}}</textarea>
    {{else}}
    <p>{{recap}}</p>
    {{/if}}
  </section>
  {{/if}}

  {{#if menu.length}}
  <nav class="menu">
    {{#each menu}}
    <button type="button" class="mi{{#if this.missing}} missing{{/if}}" data-action="openEntry" data-index="{{this.index}}" {{#unless this.open}}disabled{{/unless}}>
      <i class="fa-solid {{this.icon}}" inert></i><span>{{this.name}}</span>
    </button>
    {{/each}}
  </nav>
  {{/if}}

  <section class="cast">
    {{#each cast}}
    <div class="pc" style="--i: {{this.index}}; --rk: var({{this.cssVar}})">
      <button type="button" class="frame" data-action="openActor" data-uuid="{{this.uuid}}" {{#unless this.canOpen}}disabled{{/unless}} aria-label="{{this.name}}">
        {{#if this.portrait}}<img src="{{this.portrait}}" alt="" style="{{this.frameStyle}}" draggable="false">{{else}}<span class="ph">{{this.initial}}</span>{{/if}}
      </button>
      <span class="rank">{{this.rank}}</span>
      <div class="plate">
        <span class="nm">{{this.name}}</span>
        {{#if this.player}}<span class="pl"><span class="k">{{localize "PARADIGMENGINE.Header.Player"}}</span>{{this.player}}</span>{{/if}}
        <span class="pips">{{#each this.hearts}}<i class="{{#if this}}on{{/if}}"></i>{{/each}}</span>
        <span class="pips e">{{#each this.energy}}<i class="{{#if this}}on{{/if}}"></i>{{/each}}</span>
      </div>
    </div>
    {{/each}}
  </section>

  <footer class="foot">
    {{#if party}}
    <div class="party">
      <span class="emblem">{{#if party.emblem}}<img src="{{party.emblem}}" alt="">{{else}}{{party.initial}}{{/if}}</span>
      <span class="pn">{{party.name}}</span>
    </div>
    {{else}}<span></span>{{/if}}
    {{#if session}}<div class="session"><span class="k">{{localize "PARADIGMENGINE.Title.NextSession"}}</span><span class="v">{{session}}</span></div>{{/if}}
    <button type="button" class="enter" data-action="enter"><span>{{localize "PARADIGMENGINE.Title.Enter"}}</span><span class="arrow">&#10140;</span></button>
  </footer>

  {{#if gm}}
  <button type="button" class="gm-edit{{#if editing}} on{{/if}}" data-action="toggleEdit" aria-label="{{localize "PARADIGMENGINE.Title.Edit"}}"><i class="fa-solid fa-pen" inert></i></button>
  {{/if}}
</div>

{{!-- Always a second top-level element: a root part that renders one element alone
     is unwrapped into the application element by the Handlebars mixin. --}}
<aside class="drawer">
{{#if drawer}}
  <h1>{{localize "PARADIGMENGINE.Title.Title"}}{{#if party}}<small>{{party.name}}</small>{{/if}}</h1>

  <div class="sec">
    <h2>{{localize "PARADIGMENGINE.Title.Background"}}</h2>
    <div class="tiles">
      {{#each drawer.backgrounds}}
      <button type="button" class="tile bg-{{this.id}}{{#if this.on}} on{{/if}}" data-action="pickBg" data-id="{{this.id}}">
        <span class="sw"{{#if this.style}} style="{{this.style}}"{{/if}}></span><span class="lb">{{this.label}}</span>
      </button>
      {{/each}}
    </div>
    <div class="chips">
      {{#each drawer.fx}}<button type="button" class="chip{{#if this.on}} on{{/if}}" data-action="toggleFx" data-id="{{this.id}}">{{this.label}}</button>{{/each}}
      <button type="button" class="chip pick" data-action="pickImage"><i class="fa-solid fa-folder-open" inert></i>{{localize "PARADIGMENGINE.Title.Bg.image"}}</button>
    </div>
  </div>

  <div class="sec">
    <h2>{{localize "PARADIGMENGINE.Title.Look"}}</h2>
    <div class="tiles">
      {{#each drawer.looks}}
      <button type="button" class="tile look look-{{this.id}}{{#if this.on}} on{{/if}}" data-action="pickLook" data-id="{{this.id}}"><span class="sw">Aa</span><span class="lb">{{this.label}}</span></button>
      {{/each}}
    </div>
  </div>

  <div class="sec">
    <h2>{{localize "PARADIGMENGINE.Title.Layout"}}</h2>
    <div class="chips">{{#each drawer.layouts}}<button type="button" class="chip{{#if this.on}} on{{/if}}" data-action="pickLayout" data-id="{{this.id}}">{{this.label}}</button>{{/each}}</div>
  </div>

  <div class="sec">
    <h2>{{localize "PARADIGMENGINE.Title.Portraits"}}</h2>
    <div class="chips">{{#each drawer.shapes}}<button type="button" class="chip{{#if this.on}} on{{/if}}" data-action="pickShape" data-id="{{this.id}}">{{this.label}}</button>{{/each}}</div>
    <div class="chips">{{#each drawer.cast}}<button type="button" class="chip{{#if this.on}} on{{/if}}" data-action="toggleCast" data-id="{{this.id}}">{{this.label}}</button>{{/each}}</div>
  </div>

  <div class="sec">
    <h2>{{localize "PARADIGMENGINE.Title.Blocks"}}</h2>
    <div class="chips">{{#each drawer.blocks}}<button type="button" class="chip{{#if this.on}} on{{/if}}" data-action="toggleBlock" data-id="{{this.id}}">{{this.label}}</button>{{/each}}</div>
  </div>

  <div class="sec">
    <h2>{{localize "PARADIGMENGINE.Title.Menu"}}</h2>
    <div class="mlist">
      {{#each menu}}
      <div class="it{{#if this.missing}} missing{{/if}}"><i class="fa-solid {{this.icon}}" inert></i><span class="n">{{this.name}}</span><button type="button" class="x" data-action="removeEntry" data-index="{{this.index}}" aria-label="{{localize "PARADIGMENGINE.Edit.Remove"}}">&#10005;</button></div>
      {{/each}}
      <div class="slot"><i class="fa-solid fa-plus" inert></i></div>
    </div>
    {{#if drawer.builtins.length}}
    <div class="chips">{{#each drawer.builtins}}<button type="button" class="chip" data-action="addBuiltin" data-id="{{this.id}}"><i class="fa-solid {{this.icon}}" inert></i>{{this.label}}</button>{{/each}}</div>
    {{/if}}
  </div>

  <div class="sec">
    <h2>{{localize "PARADIGMENGINE.Title.Show"}}</h2>
    <div class="chips"><button type="button" class="chip{{#if drawer.login}} on{{/if}}" data-action="toggleLogin">{{localize "PARADIGMENGINE.Title.OpenOnLogin"}}</button></div>
    <button type="button" class="btn primary" data-action="showAll"><i class="fa-solid fa-tv" inert></i>{{localize "PARADIGMENGINE.Title.ShowToPlayers"}}</button>
  </div>
{{/if}}
</aside>
