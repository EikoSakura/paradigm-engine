<div class="areabody">
  <div class="szrow">
    <span class="szlabel">{{localize "PARADIGMENGINE.Area.Size"}}</span>
    <span class="stepper">
      <button type="button" data-action="step" data-dir="-1"
        aria-label="{{localize "PARADIGMENGINE.Area.Smaller"}}"{{#if downDisabled}} disabled{{/if}}>−</button>
      <span class="szval">{{size}}</span>
      <button type="button" data-action="step" data-dir="1"
        aria-label="{{localize "PARADIGMENGINE.Area.Larger"}}"{{#if upDisabled}} disabled{{/if}}>＋</button>
    </span>
    <span class="sztiles">{{localize "PARADIGMENGINE.Vitals.Tiles"}}</span>
  </div>
  <button type="button" class="placebtn" data-action="place">{{localize "PARADIGMENGINE.Area.Place"}}</button>
</div>
