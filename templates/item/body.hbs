<main class="ibody">
  <div class="pcard" style="--tc: var(--blue)">
    <span class="tag">{{localize "PARADIGMENGINE.Item.Description"}}</span>
    {{#if editMode}}
    <prose-mirror class="content-sized" name="system.text" toggled value="{{system.text}}"
      data-document-uuid="{{document.uuid}}">{{{enrichedText}}}</prose-mirror>
    {{else}}
    <div class="txt">{{{enrichedText}}}</div>
    {{/if}}
  </div>
</main>
