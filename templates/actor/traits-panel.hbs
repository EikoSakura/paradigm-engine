<div class="panel">
  <div class="panel-h"><span class="en">{{localize "PARADIGMENGINE.Panel.Traits"}}</span></div>
  <div class="panel-b">
    {{#each traits}}
    <div class="card draggable" data-item-id="{{this.id}}">
      <div class="card-h">
        {{> "systems/paradigm-engine/templates/actor/badge.hbs" this.badge}}
        {{#if @root.editMode}}
        <button type="button" class="ttl ttl-open" data-action="openItem" data-item-id="{{this.id}}"><b>{{this.name}}</b></button>
        {{else}}
        <span class="ttl"><b>{{this.name}}</b></span>
        {{/if}}
        {{#if this.area}}
        <button type="button" class="chip areachip" data-action="openArea" data-item-id="{{this.id}}">{{localize "PARADIGMENGINE.Item.Area"}}</button>
        {{/if}}
        <button type="button" class="postbtn" data-action="postItem" data-item-id="{{this.id}}"
          data-tooltip="PARADIGMENGINE.Chat.Post" aria-label="{{localize "PARADIGMENGINE.Chat.Post"}}"><i class="fa-solid fa-message"></i></button>
        {{#if @root.editMode}}
        <button type="button" class="delbtn" data-action="deleteItem" data-item-id="{{this.id}}"
          aria-label="{{localize "PARADIGMENGINE.Edit.Remove"}}">✕</button>
        {{/if}}
      </div>
      <div class="card-text">{{{this.enrichedText}}}</div>
      {{#each this.rulings}}
      <div class="ruled"><em>{{localize "PARADIGMENGINE.RuledInPlay"}}</em> {{this}}</div>
      {{/each}}
    </div>
    {{/each}}
    {{#if editMode}}
    <button type="button" class="addbtn" data-action="createItem" data-type="trait">{{localize "PARADIGMENGINE.Edit.AddTrait"}}</button>
    {{/if}}
  </div>
</div>
