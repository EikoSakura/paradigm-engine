<div>
  <div class="panel">
    <div class="panel-h"><span class="en">{{localize "PARADIGMENGINE.Panel.Attributes"}}</span></div>
    <div class="panel-b">
      {{#each attributes}}
      <div class="attr">
        {{#if @root.editMode}}
        <button type="button" class="rkbtn" data-action="stepRank" data-kind="attribute" data-key="{{this.key}}"
          data-dir="-1" aria-label="{{localize "PARADIGMENGINE.Edit.RankDown"}}">−</button>
        {{/if}}
        {{> "systems/paradigm-engine/templates/actor/badge.hbs" this.badge}}
        {{#if @root.editMode}}
        <button type="button" class="rkbtn" data-action="stepRank" data-kind="attribute" data-key="{{this.key}}"
          data-dir="1" aria-label="{{localize "PARADIGMENGINE.Edit.RankUp"}}">＋</button>
        <span class="nm"><b>{{this.name}}</b><span>{{this.desc}}</span></span>
        {{else}}
        <button type="button" class="nm nm-roll" data-action="openRoll" data-first="attribute"
          data-key="{{this.key}}"><b>{{this.name}}</b><span>{{this.desc}}</span></button>
        {{/if}}
      </div>
      {{/each}}
    </div>
  </div>
  <div class="panel">
    <div class="panel-h"><span class="en">{{localize "PARADIGMENGINE.Panel.Ranks"}}</span></div>
    <div class="panel-b">
      <table class="ladder">
        <thead>
          <tr>
            <th>{{localize "PARADIGMENGINE.Ladder.Rank"}}</th>
            <th>{{localize "PARADIGMENGINE.Ladder.Die"}}</th>
            <th>{{localize "PARADIGMENGINE.Ladder.Difficulty"}}</th>
          </tr>
        </thead>
        <tbody>
          {{#each ladder}}
          <tr>
            <td class="rk" style="color: var({{this.cssVar}})">{{this.rank}}</td>
            <td>{{this.die}}</td>
            <td>{{this.difficulty}}</td>
          </tr>
          {{/each}}
          <tr><td class="rk" style="color: var(--beni)">SS</td><td></td><td>22</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</div>
