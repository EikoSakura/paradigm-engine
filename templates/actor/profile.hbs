<section class="tab profile {{tab.cssClass}}" data-group="primary" data-tab="profile">
  {{#*inline "prosecard"}}
  <div class="pcard ptext" style="--tc: var({{tc}})">
    <span class="tag">{{label}}</span>
    {{#if @root.editMode}}
    <prose-mirror class="content-sized" name="system.{{key}}" value="{{raw}}"
      data-document-uuid="{{@root.document.uuid}}">{{{html}}}</prose-mirror>
    {{else}}
    <div class="txt">{{{html}}}</div>
    {{/if}}
  </div>
  {{/inline}}

  <div class="pcard identity" style="--tc: var(--violet)">
    <span class="tag">{{localize "PARADIGMENGINE.Profile.Identity"}}</span>
    <div class="cells">
      {{#each identity}}
      <div class="cell">
        <div class="cl">{{this.label}}</div>
        {{#if @root.editMode}}
        <input class="ed-input" type="text" name="system.{{this.key}}" value="{{this.value}}" aria-label="{{this.label}}">
        {{else if this.value}}
        <div class="cv">{{this.value}}</div>
        {{else}}
        <div class="cv empty">·</div>
        {{/if}}
      </div>
      {{/each}}
    </div>
  </div>

  <div class="two">
    {{> prosecard profile.personality}}
    {{> prosecard profile.history}}
  </div>

  {{> prosecard profile.notes}}
</section>
