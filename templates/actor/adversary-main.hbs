<section class="tab main active">
  <div class="maingrid">
    {{> "systems/paradigm-engine/templates/actor/rail.hbs"}}
    <div>
      <div class="panel">
        <div class="panel-h"><span class="en">{{localize "PARADIGMENGINE.Panel.DesireFear"}}</span></div>
        <div class="panel-b">
          {{#if editMode}}
          <div class="field">
            <div class="flabel">{{localize "PARADIGMENGINE.Adversary.Desire"}}</div>
            <input class="ed-input" type="text" name="system.desire" value="{{system.desire}}">
          </div>
          <div class="field">
            <div class="flabel">{{localize "PARADIGMENGINE.Adversary.Fear"}}</div>
            <input class="ed-input" type="text" name="system.fear" value="{{system.fear}}">
          </div>
          {{else}}
          <div class="field">
            <div class="flabel">{{localize "PARADIGMENGINE.Adversary.Desire"}}</div>
            <div class="fval">{{#if system.desire}}{{system.desire}}{{else}}<span class="empty">·</span>{{/if}}</div>
          </div>
          <div class="field">
            <div class="flabel">{{localize "PARADIGMENGINE.Adversary.Fear"}}</div>
            <div class="fval">{{#if system.fear}}{{system.fear}}{{else}}<span class="empty">·</span>{{/if}}</div>
          </div>
          {{/if}}
        </div>
      </div>
      {{> "systems/paradigm-engine/templates/actor/traits-panel.hbs"}}
      {{> "systems/paradigm-engine/templates/actor/techniques-panel.hbs"}}
    </div>
  </div>
</section>
