<div class="pe-card bond">
  <span class="ctag"><span>{{localize "PARADIGMENGINE.Bond.Title"}}</span></span>
  <div class="chead">
    <span class="rk" style="--rk: var({{cssVar}})">{{rank}}</span>
    <span class="cname">{{name}}</span>
  </div>
  <div class="cbody">
    <div class="rline"><i class="rmark"></i><span>{{line}}</span></div>
    {{#if detail}}<div class="rline"><i class="rmark"></i><span>{{detail}}</span></div>{{/if}}
  </div>
</div>
