<div class="row{{#if won}} won{{/if}}" data-row="{{index}}">
  <img class="pf" src="{{img}}" alt="">
  <span class="rname">{{name}}</span>
  {{#if card}}
  <span class="mfaces dicerow">
    {{#each card.faces}}<span class="facewrap"><span class="face sm{{#if this.lucky}} lucky{{/if}}{{#if this.flipped}} flipped{{/if}}" data-index="{{this.index}}">{{this.value}}{{#if this.s}}<b class="stag">S</b>{{/if}}</span>{{#if ../card.canFlip}}<button type="button" class="flipglyph sm" data-index="{{this.index}}" aria-label="{{localize "PARADIGMENGINE.Roll.Flip"}}">&#8645;</button>{{/if}}</span>{{/each}}
  </span>
  <span class="mtotal">{{card.total}}</span>
  {{#if card.band}}<span class="mband{{#if card.band.combo}} cb{{else if card.band.success}} ok{{else if card.band.fumble}} no{{/if}}">{{card.band.word}}</span>{{/if}}
  {{#if card.hearts}}<span class="mband no">{{card.hearts}}</span>{{/if}}
  {{#if result}}<span class="mband no">{{result}}</span>{{/if}}
  {{else}}
  <button type="button" class="cbtn o mroll" data-row="{{index}}" data-uuid="{{uuid}}">{{rollLabel}}</button>
  {{/if}}
</div>
