<div class="pe-card roll">
  <span class="ctag"><span>{{localize "PARADIGMENGINE.Roll.Title"}}</span>{{#if clash}}<small>{{localize "PARADIGMENGINE.Clash.Title"}} · {{clash.name}}</small>{{/if}}</span>
  <div class="chead">
    <span class="cname">{{title}}</span>
  </div>
  <div class="cbody">
    <div class="dicerow">
      {{#each faces}}
      <span class="face{{#if this.lucky}} lucky{{/if}}{{#if this.flipped}} flipped{{/if}}{{#if this.traded}} traded{{/if}}" data-index="{{this.index}}">{{this.value}}{{#if this.s}}<b class="stag">S</b>{{/if}}</span>
      {{/each}}
      <div class="rtotal">
        <span class="tlab">{{localize "PARADIGMENGINE.Roll.Total"}}</span>
        <span class="tnum">{{total}}</span>
      </div>
    </div>
    {{#each luck}}
    <div class="rline luck"><i class="rmark"></i><span>{{this}}</span></div>
    {{/each}}
    {{#each trades}}
    <div class="rline trade"><i class="rmark"></i><span>{{this}}</span></div>
    {{/each}}
    {{#each flips}}
    <div class="rline flip"><i class="rmark"></i><span>{{this}}</span></div>
    {{/each}}
    {{#if energy}}
    <div class="rline energy"><i class="rmark"></i><span>{{energy}}</span></div>
    {{/if}}
    {{#if hearts}}
    <div class="rline hearts"><i class="rmark"></i><span>{{hearts}}</span></div>
    {{/if}}
    {{#if band}}
    <div class="dband">
      <span class="dtag" style="--gc: var({{band.cssVar}})"><b>{{band.rank}}</b><small>{{band.number}}</small></span>
      <span class="bword {{#if band.combo}}combo{{else if band.fumble}}fumble{{else if band.success}}success{{else}}failure{{/if}}">{{band.word}}</span>
    </div>
    {{#if band.limitBreak}}<div class="lbline"><span class="lbtag">{{band.limitBreak}}</span></div>{{/if}}
    {{/if}}
    {{#if band.riders.length}}
    <div class="riders">
      {{#each band.riders}}<div data-rider="{{this.key}}">{{this.text}}</div>{{/each}}
    </div>
    {{/if}}
    {{#if clash}}
    <div class="cfoot clashfoot">
      <span class="sidename">{{clash.name}}</span>
      <span class="boxes">{{#each clash.boxes}}<i class="{{#if this.fresh}}fresh{{else if this.on}}on{{/if}}"></i>{{/each}}</span>
      {{#if canFlip}}<button type="button" class="cbtn o flipbtn">{{localize "PARADIGMENGINE.Roll.Flip"}}</button>{{/if}}
      <button type="button" class="cbtn o tradebtn">{{localize "PARADIGMENGINE.Clash.Trade"}}</button>
    </div>
    {{else if canFlip}}
    <div class="cfoot">
      <button type="button" class="cbtn o flipbtn">{{localize "PARADIGMENGINE.Roll.Flip"}}</button>
    </div>
    {{/if}}
  </div>
</div>
