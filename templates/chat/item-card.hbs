<div class="pe-card skill">
  <span class="ctag"><span>{{kindLabel}}</span></span>
  <div class="chead">
    <span class="rk" style="--rk: var({{cssVar}})">{{rank}}</span>
    <span class="cname">{{name}}</span>
    {{#if costLabel}}<span class="chip gold">{{costLabel}}</span>{{/if}}
  </div>
  <div class="cbody prose">
    {{{enrichedText}}}
  </div>
</div>
