<div class="pe-card">
  <div class="chead">
    <div class="ctitle">
      <span class="dia" style="--rkc: var({{cssVar}})"><i></i><b>{{rank}}</b></span>
      <span class="cname">{{name}}</span>
    </div>
    <div class="cmeta">
      <span class="chip{{#if activated}} pap{{else}} inv{{/if}}">{{kindLabel}}</span>
      <span class="chip gold">{{costLabel}}</span>
    </div>
  </div>
  <div class="cbody">
    {{{enrichedText}}}
    {{#each rulings}}
    <div class="ruled"><span class="rmark">◆</span><span>{{this}}</span></div>
    {{/each}}
  </div>
</div>
